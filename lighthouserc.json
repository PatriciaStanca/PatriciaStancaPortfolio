{
  "ci": {
    "collect": {
      "startServerCommand": "npx http-server -a 127.0.0.1 -p 4173 -c-1",
      "startServerReadyPattern": "Available on",
      "url": [
        "http://127.0.0.1:4173/index.html",
        "http://127.0.0.1:4173/generic.html",
        "http://127.0.0.1:4173/elements.html",
        "http://127.0.0.1:4173/contact.html",
        "http://127.0.0.1:4173/privacy.html",
        "http://127.0.0.1:4173/cv.html"
      ],
      "settings": {
        "preset": "desktop"
      },
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
